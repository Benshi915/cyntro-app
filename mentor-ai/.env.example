# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mentor_knowledge

# ── Whisper ────────────────────────────────────────────────────────────────────
# Options: tiny | base | small | medium | large
# "base" is a good default — fast on CPU, accurate enough.
# Use "medium" or "large" for better accuracy (needs more RAM).
WHISPER_MODEL=base

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_WORD_SIZE=500
CHUNK_OVERLAP=50

# ── API server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
