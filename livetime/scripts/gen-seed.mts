// Generates supabase/seed.sql from src/lib/demo-data.ts so the real DB starts with the demo network.
// Run: node scripts/gen-seed.mts
import { writeFileSync } from "node:fs";
import { buildDemoEvents, buildDemoPosts, demoEventSeeds, demoPostSeeds, demoProfiles } from "../src/lib/demo-data.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number" || typeof v === "boolean") return String(v);
  if (Array.isArray(v)) return `array[${v.map(q).join(", ")}]::text[]`;
  if (typeof v === "object") return `${q(JSON.stringify(v))}::jsonb`;
  return `'${String(v).replace(/'/g, "''")}'`;
};

const profileCols = [
  "id", "role", "handle", "display_name", "tagline", "bio", "city", "lat", "lng", "genres", "links", "verified",
  "act_type", "members_count", "fee_min", "fee_max", "set_length_min", "open_to_door_deals", "tech_needs",
  "venue_type", "capacity", "address", "has_stage", "has_sound_system", "has_piano", "equipment",
  "budget_min", "budget_max", "music_nights", "followers_count", "bring_count",
] as const;

const lines: string[] = [
  "-- Generated by scripts/gen-seed.mts — demo network (fictional). Profiles have no owner and can be claimed later.",
  "-- Event and post times are relative to when the seed runs.",
  "",
  `insert into public.profiles (${profileCols.join(", ")}) values`,
  demoProfiles
    .map((p) => `  (${profileCols.map((c) => (c === "genres" && !p.genres.length ? "'{}'::text[]" : q(p[c]))).join(", ")})`)
    .join(",\n") + "\non conflict (id) do nothing;",
  "",
];

const events = buildDemoEvents();
lines.push(
  "insert into public.events (id, created_by, venue_id, artist_id, title, description, starts_at, address, city, lat, lng, genres, ticket_price, tips_enabled, capacity, going_count, interested_count) values",
  events
    .map((e, i) => {
      const s = demoEventSeeds[i];
      const startsAt = `((current_date + ${s.day}) + time '${s.time}') at time zone 'Asia/Jerusalem'`;
      return `  (${[e.id, e.created_by, e.venue_id, e.artist_id, e.title, e.description].map(q).join(", ")}, ${startsAt}, ${[e.address, e.city, e.lat, e.lng, e.genres, e.ticket_price, e.tips_enabled, e.capacity, e.going_count, e.interested_count].map(q).join(", ")})`;
    })
    .join(",\n") + "\non conflict (id) do nothing;",
  "",
);

const posts = buildDemoPosts();
lines.push(
  "insert into public.posts (id, profile_id, body, encore_count, created_at) values",
  posts
    .map((p, i) => `  (${[p.id, p.profile_id, p.body, p.encore_count].map(q).join(", ")}, now() - interval '${demoPostSeeds[i].hoursAgo} hours')`)
    .join(",\n") + "\non conflict (id) do nothing;",
  "",
);

writeFileSync("supabase/seed.sql", lines.join("\n"));
console.log(`seed.sql: ${demoProfiles.length} profiles, ${events.length} events, ${posts.length} posts`);
